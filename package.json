{
  "name": "brave-auto-page-translator",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Private, context-aware webpage and writing translation for Brave and Chromium browsers.",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepare:e2e": "node scripts/prepare-e2e-extension.mjs",
    "test:e2e": "npm run prepare:e2e && playwright test",
    "validate": "node scripts/validate.mjs && npm test",
    "validate:full": "npm run validate && npm run test:e2e",
    "package": "node scripts/package.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "checksums": "node scripts/checksums.mjs",
    "audit": "npm audit --audit-level=high",
    "store:assets": "node scripts/generate-store-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@resvg/resvg-js": "2.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
