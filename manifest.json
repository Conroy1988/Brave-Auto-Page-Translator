{
  "manifest_version": 3,
  "name": "Brave Auto Page Translator",
  "short_name": "Auto Translator",
  "version": "0.1.2",
  "description": "Automatically translates foreign-language webpages using configurable language and website rules.",
  "author": "Conroy1988",
  "homepage_url": "https://github.com/Conroy1988/Brave-Auto-Page-Translator",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Brave Auto Page Translator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
